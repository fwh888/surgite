DATABASE_URL=postgresql://standup:standup@db:5432/standup
API_HOST=0.0.0.0
API_PORT=8000

# Optional: use a pre-built app image from a container registry instead of
# building from source. Leave unset to build locally with `docker compose up --build`.
# APP_IMAGE=your-registry/standup-gen-app:latest

# AI summary provider: anthropic | groq | deepseek
LLM_PROVIDER=anthropic

# API keys (only the provider you use needs one)
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
DEEPSEEK_API_KEY=sk-...

# Optional per-provider model overrides (sensible defaults are built in)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_MODEL=deepseek-chat

STANDUP_USER=Your Name
STANDUP_ROLE=your role at your company
