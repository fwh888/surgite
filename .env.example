# Copy to .env and adjust, then run `docker compose up --build`.
# Every value here has a working default — the app runs with an empty .env.

# --- Database ---------------------------------------------------------------
# Compose starts Postgres with these and points the app at it. Change the
# password for anything beyond local use.
POSTGRES_USER=standup
POSTGRES_PASSWORD=standup
POSTGRES_DB=standup

# --- AI summaries (optional) ------------------------------------------------
# The app works with NO key set: you still get formatted commit logs and
# non-AI summaries. Add a key only to enable AI-written prose summaries.
# Provider: anthropic | groq | deepseek
LLM_PROVIDER=anthropic

# Only the provider selected above needs a key. Leave the others blank.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional per-provider model overrides (sensible defaults are built in):
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GROQ_MODEL=llama-3.1-8b-instant
# DEEPSEEK_MODEL=deepseek-chat

# --- Summary identity (optional) --------------------------------------------
# Injected into the AI prompt so summaries read in your voice.
STANDUP_USER=
STANDUP_ROLE=

# --- Auth (0.5.0) -----------------------------------------------------------
# AUTH_MODE selects how requests resolve to a user:
#   off         — anonymous; all data owned by the bootstrap user. The
#                 backward-compatible default; fine on a trusted network.
#   single_user — same single-user data model, but the auth machinery (session
#                 hashing) is active. No login UI.
#   multi_user  — full email+password session auth; /login + /logout exposed.
#                 Required to expose the app to people who aren't the operator.
#                 Refuses plain HTTP — terminate TLS in front of it.
AUTH_MODE=off

# The account that owns all data in off/single_user mode and the backfill
# target for the 0.4.0 -> 0.5.0 migration. On a multi_user first run the app
# logs an admin invite for this address (redeem with `standup --redeem-invite`).
BOOTSTRAP_OWNER_EMAIL=owner@localhost

# Session lifetime / sliding-refresh threshold (days) and cleanup cadence (s).
# SESSION_TTL_DAYS=14
# SESSION_REFRESH_THRESHOLD_DAYS=7
# SESSION_CLEANUP_INTERVAL=3600

# Set DEBUG=true ONLY for local plain-HTTP dev: it drops the cookie's __Host-
# prefix and Secure flag so a browser will accept it over http://. Never in
# production.
# DEBUG=false

# --- Advanced ---------------------------------------------------------------
# Host port to publish the app on (the container always listens on 8000).
API_PORT=8000

# Lifetime of a shared-summary link (the /s/<slug> URLs). Default 7 days.
# SHARE_TTL_DAYS=7

# --- CLI --registered mode (optional) ---------------------------------------
# `standup --registered <name>` talks to a running API instead of a local
# clone. Point it at your instance. For a multi_user instance, authenticate
# with `standup --login` (saves a session) or set a long-lived STANDUP_API_KEY.
# STANDUP_API_URL=http://localhost:8000
# STANDUP_API_KEY=
# STANDUP_API_TOKEN is the deprecated 0.4.0 name for STANDUP_API_KEY; it still
# works but logs a warning. Rename it.

# Use a pre-built image instead of building from source:
# APP_IMAGE=your-registry/standup-gen-app:latest

# Running the API directly (not via compose)? Set the full DB URL instead of
# the POSTGRES_* vars above (note: localhost, not the compose "db" host):
# DATABASE_URL=postgresql://standup:standup@localhost:5432/standup
