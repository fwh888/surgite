# Build context exclusions. The Dockerfile does `COPY . .`, so anything not
# listed here lands in the image.

# --- Secrets ----------------------------------------------------------------
# .secrets_key is the Fernet master key for at-rest provider-key encryption,
# auto-generated by surgite/secrets.py on first run. A developer who has run
# the app locally has one; without this line `docker build` bakes it into the
# image and it ships to whatever registry the image is pushed to.
.secrets_key
.env

# --- Build output and caches ------------------------------------------------
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.task/

# --- Not needed at runtime --------------------------------------------------
.git/
.gitignore
.github/
.forgejo/
.vscode/
.claude/
tests/
docs/
backups/
ingest.log
*.log
.DS_Store
